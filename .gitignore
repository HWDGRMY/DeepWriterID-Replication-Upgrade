# 重构过程中的文件备份（不随仓库分发）
_refactor_backup/

# 论文文本提取的中间产物
_paper.txt
_pdf_text.txt

# 已被本 README 取代的旧版说明
README_v2.0_backup.md

# 云端打包产物
dist/

