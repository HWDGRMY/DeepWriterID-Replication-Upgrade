# ===================== 数据 =====================
# 原始 .wptt 轨迹（体积大且有版权，需自行从 NLPR 下载）
data/raw/*
!data/raw/.gitkeep
!data/raw/**/.gitkeep

# 切分结果缓存（可重新生成）
data/cache/
data/features/*.npy

# ===================== 训练产出物 =====================
outputs/
!outputs/.gitkeep

